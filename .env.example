# Discord Settings
DISCORD_TOKEN='your_bot_token'
APP_ID='your_application_id'
GUILD_ID='your_guild_id'
DISCORD_WEBHOOK_URL='your_webhook_url'

# AWS Infrastructure Settings (setup_config.py targets)
AWS_ACCESS_KEY_ID='your_aws_access_key_id'
AWS_SECRET_ACCESS_KEY='your_aws_secret_access_key'
AWS_REGION='ap-northeast-1'
AWS_ACCOUNT_ID='123456789012'
INSTANCE_ID='i-xxxxxxxxxxxxxxxxx'
S3_BUCKET_NAME='your-factorio-bucket-name'
SAVE_FILE_KEY='save.zip'

# Factorio Server Settings
RCON_PASSWORD='your_rcon_password'

# セットアップ時の確認管理用（スクリプトによる自動置換・同期の対象外）
DISCORD_PUBLIC_KEY='your_public_key'
S3_FILES_SYSTEM_ID='fs-xxxxxxxxxxxxxxxxx'
