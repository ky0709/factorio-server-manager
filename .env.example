# Discord Settings
DISCORD_TOKEN='your_discord_bot_token_here'
APP_ID='your_discord_application_id_here'
GUILD_ID='your_discord_guild_id_here'
DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/your_webhook_id/your_webhook_token'
DISCORD_LOG_WEBHOOK_URL='https://discord.com/api/webhooks/your_log_webhook_id/your_log_webhook_token'
DISCORD_PUBLIC_KEY='your_discord_application_public_key_hex'
ADMIN_USER_IDS='your_admin_user_id_comma_separated_if_multiple'
ADMIN_ROLE_IDS='your_admin_role_ids_comma_separated_if_multiple'
RESTRICTED_COMMAND_STRINGS='start,stop,save,restore:select'
STRICT_ADMIN_USER_COMMAND_STRINGS='config,mods,admin'
EPHEMERAL_COMMAND_STRINGS='status,restore:list,pass,license'
OAUTH2_URL='' #Check Only

# AWS General Settings
AWS_REGION='ap-northeast-1'
AWS_ACCOUNT_ID='123456789012'
INSTANCE_ID='i-0123456789abcdef0'
SERVICE_UNIT_NAME='factorio' # systemd unit to stop/start on target EC2 (e.g. factorio, factorio-dev, factorio-prod)
SERVER_SETTINGS_FILE_NAME='server-settings.json' # file name under /mnt/factorio-data/config/ used by Factorio service and Executor startup checks
# Using AWS Named Profiles is recommended. Avoid hardcoding access keys here.
AWS_PROFILE='your_aws_profile_name'

# EventBridge / Scheduler Names (Optional: Defaults will be Factorio-xxx or Factorio-xxx-dev)
AUTO_CHECK_SCHEDULE_NAME='Factorio-AutoCheck'
DAILY_STOP_SCHEDULE_NAME='Factorio-DailyStop'
EC2_STATE_RULE_NAME='Factorio-EC2StateChange'

SSM_PARAMETER_PATH='/factorio/'
AUTO_CHECK_SCHEDULE='rate(5 minutes)' # cron(...) or rate(...)
DAILY_STOP_CRON='cron(0 15 * * ? *)' # Default: 00:00 JST (15:00 UTC)

# S3 Settings
S3_BUCKET_NAME='your-factorio-save-bucket-name'
SAVE_FILE_KEY='saves/save.zip'
S3_FILES_SYSTEM_ID=''
# IAM role that S3 Files assumes to sync with the bucket (created/updated by init_aws_resources.py when S3_FILES_SYSTEM_ID is empty)
S3_FILES_SERVICE_ROLE_NAME='FactorioS3FilesServiceRole'

# S3 Lifecycle Settings (used by scripts/apply_s3_lifecycle.py --from-env)
# Rule IDs
S3_LIFECYCLE_SAVES_RULE_ID='saves-retention'
S3_LIFECYCLE_LOGS_RULE_ID='logs-retention'
S3_LIFECYCLE_MODS_RULE_ID='mods-retention'
S3_LIFECYCLE_CONFIG_RULE_ID='config-retention'
# saves: prod example = keep total 3 versions (current + 2 noncurrent), delete noncurrent after 7 days
S3_LIFECYCLE_SAVES_NONCURRENT_DAYS='7'
S3_LIFECYCLE_SAVES_KEEP_TOTAL_VERSIONS='3'
S3_LIFECYCLE_SAVES_ABORT_MULTIPART_DAYS='7'
# logs: prod example = expire current objects after 7 days. keep-last-file is best-effort note only.
S3_LIFECYCLE_LOGS_EXPIRATION_DAYS='7'
S3_LIFECYCLE_LOGS_NONCURRENT_DAYS='7'
S3_LIFECYCLE_LOGS_KEEP_LAST_FILE='1'
S3_LIFECYCLE_LOGS_ABORT_MULTIPART_DAYS='7'
# mods/config: keep latest version policy (noncurrent cleanup)
S3_LIFECYCLE_MODS_NONCURRENT_DAYS='1'
S3_LIFECYCLE_MODS_KEEP_TOTAL_VERSIONS='1'
S3_LIFECYCLE_MODS_ABORT_MULTIPART_DAYS='7'
S3_LIFECYCLE_CONFIG_NONCURRENT_DAYS='1'
S3_LIFECYCLE_CONFIG_KEEP_TOTAL_VERSIONS='1'
S3_LIFECYCLE_CONFIG_ABORT_MULTIPART_DAYS='7'

# DynamoDB Settings
DYNAMODB_TABLE_NAME='FactorioState'

# Lambda Function Names
INTERACTOR_LAMBDA_NAME='Factorio_Interactor'
EXECUTOR_LAMBDA_NAME='Factorio_Executor'
WORKER_LAMBDA_NAME='Factorio_Worker'
NOTIFIER_LAMBDA_NAME='Factorio_Notifier'
COMMON_LAYER_NAME='factorio-common-utils'

# Command Routing: Map commands to 'executor_lambda', 'worker_lambda', 
# or use 'maintenance' to temporarily disable a command.
COMMAND_ROUTING='{"restore": "worker_lambda", "config": "maintenance", "mods": "maintenance", "admin": "maintenance"}'

# IAM Role Names
INTERACTOR_ROLE_NAME='FactorioInteractorRole'
EXECUTOR_ROLE_NAME='FactorioExecutorRole'
WORKER_ROLE_NAME='FactorioWorkerRole'
NOTIFIER_ROLE_NAME='FactorioNotifierRole'
EVENTBRIDGE_ROLE_NAME='FactorioEventBridgeRole'

# IAM Policy Names
INTERACT_POLICY_NAME='FactorioInteractPolicy'
EXECUTE_POLICY_NAME='FactorioExecutePolicy'
NOTIFY_POLICY_NAME='FactorioNotifyPolicy'
SERVER_POLICY_NAME='FactorioServerPolicy'
REGIST_POLICY_NAME='FactorioRegistPolicy'
WORK_POLICY_NAME='FactorioWorkPolicy'
EVENTBRIDGE_POLICY_NAME='FactorioEventBridgePolicy'

# Factorio Server Settings
RCON_PASSWORD='your_rcon_password_here'
RCON_PORT='27015'
GAME_PASSWORD='your_in_game_join_password_here'
FACTORIO_GAME_PORT='34197'
RCON_COMMAND_TIMEOUT_SECONDS='5'
RCON_UNRESPONSIVE_THRESHOLD='2'
ZERO_PLAYER_THRESHOLD='3'
S3_SYNC_WAIT_THRESHOLD_SECONDS='10'
RCON_READY_CHECK_INTERVAL_SECONDS='10'
RCON_READY_CHECK_MAX_ATTEMPTS='12'

# --- Lambda Resource Configuration ---
# Memory: MB, Timeout: Seconds
EXECUTOR_MEMORY=256
EXECUTOR_TIMEOUT=180
NOTIFIER_MEMORY=128
NOTIFIER_TIMEOUT=30
WORKER_MEMORY=256
WORKER_TIMEOUT=60
INTERACTOR_MEMORY=512
INTERACTOR_TIMEOUT=10
