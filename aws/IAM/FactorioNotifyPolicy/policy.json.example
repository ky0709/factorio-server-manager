{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "SSMParameterRead",
            "Effect": "Allow",
            "Action": [
                "ssm:GetParameter"
            ],
            "Resource": [
                "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/factorio/*"
            ]
        }
    ]
}